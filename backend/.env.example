# Every variable here is validated at boot by src/config/env.validation.ts.
# A missing or malformed value stops the process with a readable error.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postman_clone

# Auth. Generate a fresh secret per environment and never commit a real one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=postman-clone
JWT_AUDIENCE=postman-clone-api
REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_COOKIE_NAME=pc_refresh_token
# The cookie is scoped to Path=/api/v1/auth, which rules out the __Host- prefix
# (it requires Path=/). Do not "fix" the name into __Host-...: the browser would
# reject the cookie and every refresh would fail.

# Refresh cookie attributes. COOKIE_SECURE defaults to true only when
# NODE_ENV=production. COOKIE_SAME_SITE=none is rejected at boot unless
# COOKIE_SECURE=true, because browsers drop such a cookie silently.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Empty = host-only, which is what a single-origin deployment wants.
COOKIE_DOMAIN=
# Window after a refresh token is first spent in which a replay is treated as
# two tabs racing rather than token theft.
REFRESH_ROTATION_GRACE_MS=10000
# Concurrent live sessions per user. Past the cap, the least recently active
# sessions are revoked (not deleted) on the next login.
MAX_SESSIONS_PER_USER=10

# There is deliberately no DB_SYNCHRONIZE. Schema changes go through
# migrations: `yarn migration:generate src/database/migrations/Name`
# then `yarn migration:run`.

# Dev seed user (created by migration AddUserNameAndSeedTestUser):
#   email: rashiqrahaman@yahoo.com
#   password: Password123!

# Rate limiting for POST /auth/register, keyed by caller IP. Two windows apply
# together: a burst bound for a spike and a sustained bound for the total.
# ⚠️ Behind a reverse proxy every request carries the proxy's address (main.ts
# does not enable Express `trust proxy`), which collapses these into one global
# bucket. Enable trust proxy before relying on them in production.
# ⚠️ Counters are in-memory and per process: N instances allow N× the limit.
THROTTLE_BURST_TTL_MS=60000
THROTTLE_BURST_LIMIT=5
THROTTLE_SUSTAINED_TTL_MS=3600000
THROTTLE_SUSTAINED_LIMIT=20

# --- Sending requests (POST /requests/:id/send) ---------------------------

# ⚠️ Turns the SSRF address policy OFF. With this on, a send can reach
# loopback, RFC1918 and 169.254.169.254 (the cloud metadata endpoint), which
# makes an authenticated account a proxy into your private network. It exists
# so a developer can point the app at their own localhost API. Never true in
# production; the app logs a warning at boot when it is on.
# DNS resolution and connection pinning still happen either way — only the
# screening step is skipped.
SEND_ALLOW_PRIVATE_NETWORK=false

SEND_CONNECT_TIMEOUT_MS=5000
# One absolute deadline spanning every redirect hop. A per-hop timeout under a
# 5-hop cap would be a 5x timeout. This is also what bounds a slowloris
# response body, which a connect timeout does not.
SEND_TOTAL_TIMEOUT_MS=30000
SEND_MAX_REDIRECTS=5
# ⚠️ A cap on DECOMPRESSED bytes. Sends ask for `identity`; if the target
# compresses anyway, zlib's maxOutputLength keeps the cap real — a cap on
# compressed bytes is not a cap, and a 5 MiB gzip is a gigabyte of RAM.
SEND_MAX_RESPONSE_BYTES=5242880
SEND_MAX_REQUEST_BODY_BYTES=1048576
# Deliberately far lower than the live cap. Stored bodies are the growth driver
# for request_executions: this x SEND_HISTORY_PER_REQUEST x every request.
SEND_MAX_STORED_BODY_BYTES=262144

# History retention, two independent policies. The per-request cap is enforced
# inside the insert's transaction; the age sweep is implemented, unit-tested
# and deliberately uncalled (a cron hook point — @nestjs/schedule is not a
# dependency), exactly like deleteExpiredSessions().
SEND_HISTORY_PER_REQUEST=50
SEND_HISTORY_RETENTION_DAYS=30

# Send's own rate-limit budget, keyed by USER ID rather than IP (every caller
# is authenticated, and req.ip is the proxy's address). The register windows
# above are sized for a signup form and would make Send unusable.
SEND_THROTTLE_BURST_TTL_MS=60000
SEND_THROTTLE_BURST_LIMIT=30
SEND_THROTTLE_SUSTAINED_TTL_MS=3600000
SEND_THROTTLE_SUSTAINED_LIMIT=600
